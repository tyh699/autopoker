{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPoker",
  "version": "0.1.0",
  "identifier": "com.autopoker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @poker/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @poker/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoPoker",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"]
  }
}
